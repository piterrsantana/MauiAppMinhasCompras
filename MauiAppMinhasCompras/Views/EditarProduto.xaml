<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.EditarProduto"
             Title="{Binding Descricao}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Salvar"
                     Clicked="ToolbarItem_Clicked" />
    </ContentPage.ToolbarItems>

    <VerticalStackLayout Spacing="10"
                         Padding="10">
        <Label Text="Descrição do Produto:" />
        <Entry x:Name="txt_descricao"
               Placeholder="Digite a descrição do produto"
               Text="{Binding Descricao}" />

        <Label Text="Categoria do Produto:" />
        <Picker x:Name="pck_categoria"
                Title="Selecione a Categoria"
                SelectedItem="{Binding Categoria}">
            <Picker.ItemsSource>
                <x:Array Type="{x:Type x:String}">
                    <x:String>Açougue</x:String>
                    <x:String>Padaria</x:String>
                    <x:String>Mercearia</x:String>
                    <x:String>Higiene</x:String>
                    <x:String>Limpeza</x:String>
                </x:Array>
            </Picker.ItemsSource>
        </Picker>

        <Label Text="Quantidade:" />
        <Entry x:Name="txt_quantidade"
               Placeholder="Digite a quantidade"
               Text="{Binding Quantidade, Mode=OneTime}"
               Keyboard="Numeric" />

        <Label Text="Preço Unitário:" />
        <Entry x:Name="txt_preco"
               Placeholder="Digite o preço unitário"
               Text="{Binding Preco, Mode=OneTime}"
               Keyboard="Numeric" />
    </VerticalStackLayout>
</ContentPage>