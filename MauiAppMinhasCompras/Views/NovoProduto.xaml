<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.NovoProduto"
             Title="Novo Produto">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Salvar" Clicked="ToolbarItem_Clicked"/>
    </ContentPage.ToolbarItems>

    <!--Aqui fica as descrições da tabela-->
    <VerticalStackLayout Spacing="10" Padding="10"> <!--Spacing separa em cima e embaixo. Padding nas laterais-->

        <Label Text="Descrição do Produto:" /><!--Descrição da coluna-->
        <Entry x:Name="txt_descricao"/> <!--Captura o que o usuário digitou-->      

        <Label Text="Quantidade:" />
        <Entry x:Name="txt_quantidade" Keyboard="Numeric" />

        <Label Text="Preço Unitário:" />
        <Entry x:Name="txt_preco" Keyboard="Numeric" />
        

    </VerticalStackLayout>
</ContentPage>