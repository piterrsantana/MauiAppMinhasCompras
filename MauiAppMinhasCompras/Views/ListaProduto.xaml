<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.ListaProduto"
             Title="Minhas Compras">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Relatorio"
                     Clicked="ToolbarItem_Relatorio_Clicked"/>
        <ToolbarItem Text="Somar"
                     Clicked="ToolbarItem_Clicked_1" />
        <ToolbarItem Text="Adicionar"
                     Clicked="ToolbarItem_Clicked" />
    </ContentPage.ToolbarItems>

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Alinha o texto no centro vertical de cada célula -->
            <Style TargetType="Label">
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <StackLayout Padding="10, 5">

        <!-- Barra de pesquisa -->
        <SearchBar x:Name="txt_search"
                   Placeholder="Busca de Produtos" 
                   Margin="0, 0, 0, 5"
                   TextChanged="txt_search_TextChanged" />

        <!-- Filtro por Categoria -->
        <Picker x:Name="pck_categoria"
                Title="Filtrar por Categoria"
                TitleColor="{StaticResource Primary}"
                Margin="0, 0, 0, 10"
                SelectedIndexChanged="pck_categoria_SelectedIndexChanged">
            <Picker.ItemsSource>
                <x:Array Type="{x:Type x:String}">
                    <x:String>Todas</x:String>
                    <x:String>Açougue</x:String>
                    <x:String>Padaria</x:String>
                    <x:String>Mercearia</x:String>
                    <x:String>Higiene</x:String>
                    <x:String>Limpeza</x:String>
                </x:Array>
            </Picker.ItemsSource>
        </Picker>

        <!-- Tabela de Produtos -->
        <ListView x:Name="lst_produtos"
                  IsPullToRefreshEnabled="True"
                  Refreshing="lst_produtos_Refreshing"
                  ItemSelected="lst_produtos_ItemSelected"
                  RowHeight="45">

            <!-- Cabeçalho da Tabela -->
            <ListView.Header>
                <Grid ColumnDefinitions="40, 2*, 90, 50, 1.5*, 100"
                      Padding="10, 8"
                      BackgroundColor="#2C2C2C">
                    <Label Grid.Column="0"
                           Text="ID"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="Descrição"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Start" />
                    <Label Grid.Column="2"
                           Text="Preço"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="End" />
                    <Label Grid.Column="3"
                           Text="Qnt"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center" />
                    <Label Grid.Column="4"
                           Text="Categoria"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Start"
                           Margin="10,0,0,0" />
                    <Label Grid.Column="5"
                           Text="Total"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="End" />
                </Grid>
            </ListView.Header>

            <!-- Linhas de Itens -->
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <ViewCell.ContextActions>
                            <MenuItem Text="Remover"
                                      Clicked="MenuItem_Clicked" />
                        </ViewCell.ContextActions>

                        <Grid ColumnDefinitions="40, 2*, 90, 50, 1.5*, 100"
                              Padding="10, 0">
                            <Label Grid.Column="0"
                                   Text="{Binding Id}"
                                   HorizontalOptions="Center"
                                   TextColor="Gray" />
                            <Label Grid.Column="1"
                                   Text="{Binding Descricao}"
                                   HorizontalOptions="Start"
                                   LineBreakMode="TailTruncation" />
                            <Label Grid.Column="2"
                                   Text="{Binding Preco, StringFormat='{0:C}'}"
                                   HorizontalOptions="End" />
                            <Label Grid.Column="3"
                                   Text="{Binding Quantidade}"
                                   HorizontalOptions="Center"
                                   FontAttributes="Bold" />
                            <Label Grid.Column="4"
                                   Text="{Binding Categoria}"
                                   HorizontalOptions="Start"
                                   Margin="10,0,0,0"
                                   FontAttributes="Italic" />
                            <Label Grid.Column="5"
                                   Text="{Binding Total, StringFormat='{0:C}'}"
                                   HorizontalOptions="End"
                                   FontAttributes="Bold" />
                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>
    </StackLayout>
</ContentPage>