<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.ListaProduto"
             Title="Minhas Compras">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Relatório"
                     Clicked="ToolbarItem_Relatorio_Clicked" />
        <ToolbarItem Text="Somar"
                     Clicked="ToolbarItem_Clicked_1" />
        <ToolbarItem Text="Adicionar"
                     Clicked="ToolbarItem_Clicked" />
    </ContentPage.ToolbarItems>

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="Label">
                <Setter Property="VerticalTextAlignment"
                        Value="Center" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <StackLayout>
        <!-- Barra de pesquisa -->
        <SearchBar x:Name="txt_search" 
                   Placeholder="Busca de Produtos"
                   Margin="10, 0, 10, 5"
                   TextChanged="txt_search_TextChanged" />

        <!-- Filtro por Categoria -->
        <Picker x:Name="pck_categoria"
                Title="Filtrar por Categoria"
                TitleColor="Gray" 
                Margin="10, 0, 10, 5"
                SelectedIndexChanged="pck_categoria_SelectedIndexChanged">
            <Picker.ItemsSource>
                <x:Array Type="{x:Type x:String}">
                    <x:String>Todas</x:String>
                    <x:String>Açougue</x:String>
                    <x:String>Padaria</x:String>
                    <x:String>Mercearia</x:String>
                    <x:String>Higiene</x:String>
                    <x:String>Limpeza</x:String>
                </x:Array>
            </Picker.ItemsSource>
        </Picker>

        <!-- Lista de produtos -->
        <ListView x:Name="lst_produtos"
                  IsPullToRefreshEnabled="True"
                  Refreshing="lst_produtos_Refreshing"
                  ItemSelected="lst_produtos_ItemSelected">
            <ListView.Header>
                <Grid ColumnDefinitions="40, 150, 80, 50, 120, 90" 
                      BackgroundColor="Black"
                      Padding="20">
                    <Label Grid.Column="0"
                           Text="ID"
                           Padding="5"
                           FontAttributes="Bold" />
                    <Label Grid.Column="1"
                           Text="Descrição"
                           FontAttributes="Bold" />
                    <Label Grid.Column="2"
                           Text="Preço"
                           FontAttributes="Bold" />
                    <Label Grid.Column="3"
                           Text="Qnt"
                           FontAttributes="Bold" />
                    <Label Grid.Column="4"
                           Text="Categoria"
                           FontAttributes="Bold" />
                    <Label Grid.Column="5"
                           Text="Total"
                           FontAttributes="Bold" />
                </Grid>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <ViewCell.ContextActions>
                            <MenuItem Text="Remover"
                                      Clicked="MenuItem_Clicked" />
                        </ViewCell.ContextActions>
                        <Grid ColumnDefinitions="40, 150, 80, 50, 120, 90"
                              BackgroundColor="Black"
                              Padding="10">
                            <Label Grid.Column="0"
                                   Text="{Binding Id}"
                                   Padding="5" />
                            <Label Grid.Column="1"
                                   Text="{Binding Descricao}" />
                            <Label Grid.Column="2"
                                   Text="{Binding Preco, StringFormat='{0:C}'}" />
                            <Label Grid.Column="3"
                                   Text="{Binding Quantidade}" />
                            <Label Grid.Column="4"
                                   Text="{Binding Categoria}"
                                   FontAttributes="Bold" />
                            <Label Grid.Column="5"
                                   Text="{Binding Total, StringFormat='{0:C}'}" />
                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackLayout>
</ContentPage>