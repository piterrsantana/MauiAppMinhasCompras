<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.ListaProduto"
             Title="Minhas Compras">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Somar" Clicked="ToolbarItem_Clicked_1"/>
        <ToolbarItem Text="Adicionar"
                     Clicked="ToolbarItem_Clicked" />
    </ContentPage.ToolbarItems>

    <!-- Troca do VerticalStackLayout pelo Grid -->
    <Grid RowDefinitions="Auto, *" Margin="30" >

        <SearchBar Grid.Row="0"
                   x:Name="txt_search"
                   Placeholder="Busca de Produtos"
                   TextChanged="txt_search_TextChanged"/>

        <ListView Grid.Row="1"
                  x:Name="lst_produtos" >

            <ListView.Header>
                <Grid ColumnDefinitions="*, *, *, *, *">
                    <Label Grid.Column="0"
                           Text="Item Nº"
                           FontAttributes="Bold" /> <!--Alterei o nome do campo para aparecer ao usuário o nº na lista em ordem, mas não altera o ID-->
                    <Label Grid.Column="1"
                           Text="Descrição"
                           FontAttributes="Bold" />
                    <Label Grid.Column="2"
                           Text="Preço"
                           FontAttributes="Bold" />
                    <Label Grid.Column="3"
                           Text="Quantidade"
                           FontAttributes="Bold" />
                    <Label Grid.Column="4"
                           Text="Total"
                           FontAttributes="Bold" />
                </Grid>
            </ListView.Header>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <ViewCell.ContextActions>
                            <MenuItem Text="Remover" 
                                      Clicked="MenuItem_Clicked"
                                      IsDestructive="True"/>
                        </ViewCell.ContextActions>
                        <Grid ColumnDefinitions="*, *, *, *, *">
                            <Label Grid.Column="0"
                                   Text="{Binding Numero}" />
                            <Label Grid.Column="1"
                                   Text="{Binding Descricao}" />
                            <Label Grid.Column="2"
                                   Text="{Binding Preco, StringFormat='{0:C}'}" />
                            <Label Grid.Column="3"
                                   Text="{Binding Quantidade}" />
                            <Label Grid.Column="4"
                                   Text="{Binding Total, StringFormat='{0:C}'}" />
                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>
    </Grid>
</ContentPage>